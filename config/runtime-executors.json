    "license": "apache-2.0",
    "command": ["{python}", "{package_root}/scripts/run_runtime_worker.py", "--kind", "embedding-reranker", "--model-id", "{model_id}", "--revision", "{revision}", "--input", "{input}", "--output", "{output}"],
    "timeout_seconds": 1800
  },
  "ocr-vision": {
