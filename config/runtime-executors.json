    "command": ["{python}", "{package_root}/scripts/run_runtime_worker.py", "--kind", "huggingface-model", "--model-id", "{model_id}", "--revision", "{revision}", "--input", "{input}", "--output", "{output}"],
    "timeout_seconds": 1800
  },
  "embedding-reranker": {
