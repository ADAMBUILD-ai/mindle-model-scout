# Optional API key for protecting programmatic /v1 endpoints.
# The same-origin web UI uses its own server-managed search route and never
# receives this value. If set, /v1 endpoints require:
#   X-API-KEY: <value>
MODEL_SCOUT_API_KEY=

# Optional local run settings
MODEL_SCOUT_HOST=0.0.0.0
MODEL_SCOUT_PORT=8080
MODEL_SCOUT_VERSION=1.0.0
